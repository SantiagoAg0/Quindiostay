# Ignorar archivos generados y dependencias

# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.log

# --- Node / Angular ---
node_modules/
dist/
.angular/
.cache/

# --- IDE ---
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Variables de entorno ---
.env
.env.*
!.env.example
